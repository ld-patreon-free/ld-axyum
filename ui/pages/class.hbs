<div class="axyum-page">
  <h2 class="axyum-page-title">{{localize "LD_AXYUM.Pages.Class"}}</h2>
  <p class="axyum-page-description">
    Choose your character's class. Each class determines your hit die, proficiencies, and special abilities.
  </p>

  <!-- Compendium Filter Buttons -->
  {{#if compendiumFilters}}
  <div class="compendium-filters">
    <span class="filter-label"><i class="fas fa-filter"></i> Filter by Source:</span>
    <div class="filter-buttons">
      {{#each compendiumFilters}}
        <button class="compendium-filter-btn {{#if (eq this.id ../selectedCompendiumFilter)}}active{{/if}}" 
                data-action="filterCompendium"
                data-filter="{{this.id}}"
                type="button">
          <i class="fas fa-book"></i>
          <span class="filter-name">{{this.name}}</span>
          <span class="filter-count">({{this.count}})</span>
        </button>
      {{/each}}
    </div>
  </div>
  {{/if}}

  <!-- Homebrew Settings -->
  <div class="homebrew-settings">
    <label class="homebrew-toggle">
      <input type="checkbox" name="showHomebrew" {{#if showHomebrew}}checked{{/if}} />
      <span class="toggle-switch"></span>
      <span class="toggle-label">Show Custom Content</span>
    </label>
    <span style="font-size: 0.9rem; color: var(--axyum-accent);">Include homebrew classes from enabled modules</span>
  </div>

  <div class="axyum-selection-grid">
    {{#each classes}}
      {{#if (or ../showHomebrew (not this.isHomebrew))}}
        <button type="button" class="axyum-selection-card {{#if (eq this.id ../character.class.id)}}selected{{/if}}" 
             data-action="selectClass"
             data-class-id="{{this.id}}" 
             data-class-name="{{this.name}}" 
             data-pack-name="{{this.packName}}"
             title="Click to select, Shift+Click to view details">
          <i class="{{this.icon}}"></i>
          <h3 class="axyum-selection-card-title">{{this.name}}</h3>
          <p class="axyum-selection-card-desc">d{{this.hitDie}} hit die{{#if this.spellcasting}} • Spellcaster{{/if}}</p>
          {{#if this.source}}
            <span class="source-badge {{#if this.isHomebrew}}homebrew{{else}}official{{/if}}" style="margin-top: 0.25rem;">
              {{#if this.isHomebrew}}<i class="fas fa-scroll"></i>{{else}}<i class="fas fa-book"></i>{{/if}}{{this.source}}
            </span>
          {{/if}}
        </button>
      {{/if}}
    {{else}}
      <p style="grid-column: 1 / -1; color: #999; text-align: center; padding: 2rem;">
        {{localize "LD_AXYUM.Messages.LoadingCompendia"}}
      </p>
    {{/each}}
  </div>

  {{#if characterData.class.id}}
    <div style="margin-top: 2rem; padding: 1.5rem; background: var(--axyum-secondary); border-left: 4px solid var(--axyum-primary); border-radius: 6px; display: flex; align-items: center; justify-content: space-between;">
      <div>
        <p style="margin: 0;"><strong>{{localize "LD_AXYUM.Messages.Selected"}}:</strong> {{characterData.class.name}}
          {{#if characterData.class.source}}
            <span class="source-badge {{#if characterData.class.isHomebrew}}homebrew{{else}}official{{/if}}">
              {{#if characterData.class.isHomebrew}}<i class="fas fa-scroll"></i>{{else}}<i class="fas fa-book"></i>{{/if}}{{characterData.class.source}}
            </span>
          {{/if}}
        </p>
      </div>
      <div style="display: flex; align-items: center;">
        <label for="primary-class-level" style="margin-right: 0.5rem; font-weight: bold;">Level:</label>
        <input type="number" id="primary-class-level" name="class.level" value="{{characterData.class.level}}" min="1" max="20" style="width: 60px; padding: 0.3rem; border: 1px solid #666; border-radius: 3px; color: #000; background: #fff;">
      </div>
    </div>
  {{/if}}

  <!-- Hidden inputs to persist selection -->
  <input type="hidden" name="class.id" value="{{characterData.class.id}}">
  <input type="hidden" name="class.name" value="{{characterData.class.name}}">
  <input type="hidden" name="class.level" value="{{characterData.class.level}}">
</div>
