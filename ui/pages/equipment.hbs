{{!-- LD Axyum - Equipment Selection Page (Horizontal Layout) --}}
<div class="axyum-page equipment-page">
  <h2 class="axyum-page-title"><i class="fas fa-shield-alt"></i> Starting Equipment</h2>
  <p class="axyum-page-description">
    Select your character's starting gear. Level 1 characters can choose up to {{maxStartingItems}} items.
  </p>

  {{!-- Equipment Layout: Sidebar + Grid --}}
  <div class="equipment-layout">
    
    {{!-- Left Sidebar: Filters & Info --}}
    <aside class="equipment-sidebar">
      
      {{!-- Class Info Panel --}}
      {{#if character.class.name}}
      <div class="equipment-class-info">
        <h4><i class="fas fa-scroll"></i> {{character.class.name}}</h4>
        <p class="class-tip">Select equipment matching your class proficiencies for best effectiveness.</p>
      </div>
      {{/if}}
      
      {{!-- Filter Buttons --}}
      <div class="equipment-filters">
        <h4><i class="fas fa-filter"></i> Filter By Type</h4>
        <div class="filter-buttons">
          <button type="button" class="filter-btn {{#unless equipmentFilter}}active{{/unless}}" data-action="filterEquipment" data-filter="">
            <i class="fas fa-th"></i> All
          </button>
          <button type="button" class="filter-btn {{#if (eq equipmentFilter 'weapon')}}active{{/if}}" data-action="filterEquipment" data-filter="weapon">
            <i class="fas fa-sword"></i> Weapons
          </button>
          <button type="button" class="filter-btn {{#if (eq equipmentFilter 'equipment')}}active{{/if}}" data-action="filterEquipment" data-filter="equipment">
            <i class="fas fa-shield-alt"></i> Armor
          </button>
          <button type="button" class="filter-btn {{#if (eq equipmentFilter 'gear')}}active{{/if}}" data-action="filterEquipment" data-filter="gear">
            <i class="fas fa-backpack"></i> Gear
          </button>
          <button type="button" class="filter-btn {{#if (eq equipmentFilter 'tool')}}active{{/if}}" data-action="filterEquipment" data-filter="tool">
            <i class="fas fa-hammer"></i> Tools
          </button>
        </div>
      </div>

      {{!-- Selection Summary --}}
      <div class="equipment-summary">
        <h4><i class="fas fa-shopping-bag"></i> Your Pack</h4>
        <div class="selection-count {{#if (gt selectedEquipmentCount maxStartingItems)}}over-limit{{/if}}">
          <span class="count-number">{{selectedEquipmentCount}}</span>
          <span class="count-label">/ {{maxStartingItems}} items</span>
        </div>
        <div class="selection-bar">
          <div class="selection-fill" style="width: {{selectionPercent}}%;"></div>
        </div>
        {{#if (gt selectedEquipmentCount maxStartingItems)}}
        <p class="over-limit-warning"><i class="fas fa-exclamation-triangle"></i> Over item limit!</p>
        {{/if}}
      </div>

      {{!-- Quick Tips --}}
      <div class="equipment-tips">
        <h4><i class="fas fa-lightbulb"></i> Tips</h4>
        <ul>
          <li>Pick one primary weapon</li>
          <li>Choose armor you're proficient with</li>
          <li>Pack essentials: rope, torch, rations</li>
        </ul>
      </div>
      
    </aside>

    {{!-- Main Content: Equipment Grid --}}
    <main class="equipment-main">
      <div class="equipment-grid">
        {{#if equipment}}
          {{#each equipment}}
            <button type="button" class="equipment-card {{#if (includes ../character.selectedEquipmentIds this.id)}}selected{{/if}}" 
                    data-action="toggleEquipment"
                    data-item-id="{{this.id}}">
              <div class="card-icon">
                {{#if (eq this.type 'weapon')}}<i class="fas fa-sword"></i>
                {{else if (eq this.type 'equipment')}}<i class="fas fa-shield-alt"></i>
                {{else if (eq this.type 'tool')}}<i class="fas fa-hammer"></i>
                {{else if (eq this.type 'consumable')}}<i class="fas fa-flask"></i>
                {{else}}<i class="fas fa-box"></i>{{/if}}
              </div>
              <div class="card-content">
                <span class="item-name">{{this.name}}</span>
                <span class="item-meta">
                  <span class="item-type">{{this.type}}</span>
                  {{#if this.price}}<span class="item-price">{{this.price}} gp</span>{{/if}}
                </span>
              </div>
              <div class="card-check"><i class="fas fa-check"></i></div>
            </button>
          {{/each}}
        {{else}}
          <div class="empty-equipment">
            <i class="fas fa-box-open"></i>
            <p>No equipment available. Check compendium settings.</p>
          </div>
        {{/if}}
      </div>
    </main>
    
  </div>
</div>
