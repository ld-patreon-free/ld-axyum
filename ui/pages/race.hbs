<div class="axyum-page">
  <h2 class="axyum-page-title">{{localize "LD_AXYUM.Pages.Race"}}</h2>
  <p class="axyum-page-description">
    Choose your character's race. Races provide ability score increases and cultural traits.
  </p>

  <!-- Compendium Filter Buttons -->
  {{#if raceCompendiumFilters}}
  <div class="compendium-filters">
    <span class="filter-label"><i class="fas fa-filter"></i> Filter by Source:</span>
    <div class="filter-buttons">
      {{#each raceCompendiumFilters}}
        <button class="race-compendium-filter-btn {{#if (eq this.id ../selectedRaceCompendiumFilter)}}active{{/if}}" 
                data-action="filterCompendium"
                data-filter="{{this.id}}"
                type="button">
          <i class="fas fa-book"></i>
          <span class="filter-name">{{this.name}}</span>
          <span class="filter-count">({{this.count}})</span>
        </button>
      {{/each}}
    </div>
  </div>
  {{/if}}

  <!-- Homebrew Settings -->
  <div class="homebrew-settings">
    <label class="homebrew-toggle">
      <input type="checkbox" name="showHomebrew" {{#if showHomebrew}}checked{{/if}} />
      <span class="toggle-switch"></span>
      <span class="toggle-label">Show Custom Content</span>
    </label>
    <span style="font-size: 0.9rem; color: var(--axyum-accent);">Include homebrew races from enabled modules</span>
  </div>

  <div class="axyum-selection-grid">
    {{#each races}}
      {{#if (or ../showHomebrew (not this.isHomebrew))}}
        <button type="button" class="axyum-selection-card {{#if (eq this.id ../character.race.id)}}selected{{/if}}"
             data-action="selectRace"
             data-race-id="{{this.id}}" 
             data-race-name="{{this.name}}"
             data-pack-name="{{this.packName}}"
             title="Click to select, Shift+Click to view details">
          <h3 class="axyum-selection-card-title">{{this.name}}</h3>
          <p class="axyum-selection-card-desc">{{this.source}}</p>
          {{#if this.source}}
            <span class="source-badge {{#if this.isHomebrew}}homebrew{{else}}official{{/if}}" style="margin-top: 0.25rem;">
              {{#if this.isHomebrew}}<i class="fas fa-scroll"></i>{{else}}<i class="fas fa-book"></i>{{/if}}{{this.source}}
            </span>
          {{/if}}
        </button>
      {{/if}}
    {{else}}
      <p style="grid-column: 1 / -1; color: #999; text-align: center; padding: 2rem;">
        {{localize "LD_AXYUM.Messages.LoadingCompendia"}}
      </p>
    {{/each}}
  </div>

  {{#if characterData.race.id}}
    <div style="margin-top: 2rem; padding: 1.5rem; background: var(--axyum-secondary); border-left: 4px solid var(--axyum-primary); border-radius: 6px;">
      <p><strong>{{localize "LD_AXYUM.Messages.Selected"}}:</strong> {{characterData.race.name}}
        {{#if characterData.race.source}}
          <span class="source-badge {{#if characterData.race.isHomebrew}}homebrew{{else}}official{{/if}}">
            {{#if characterData.race.isHomebrew}}<i class="fas fa-scroll"></i>{{else}}<i class="fas fa-book"></i>{{/if}}{{characterData.race.source}}
          </span>
        {{/if}}
      </p>
    </div>
  {{/if}}

  <input type="hidden" name="race.id" value="{{characterData.race.id}}">
  <input type="hidden" name="race.name" value="{{characterData.race.name}}">
  <input type="hidden" name="race.source" value="{{characterData.race.source}}">
  <input type="hidden" name="race.isHomebrew" value="{{characterData.race.isHomebrew}}">
</div>
