{{! D&D 5e Character Sheet - Post-Apocalyptic Axyum Theme }}
<div class="axyum-sheet-container">
  {{! Header Section }}
  <div class="sheet-header">
    <div class="character-identity">
      <div class="character-name">
        <input type="text" value="{{actor.name}}" placeholder="Character Name" class="name-input">
      </div>
      <div class="character-details">
        <div class="detail-row">
          <span class="label">Race:</span>
          <span class="value">{{features.race}}</span>
        </div>
        <div class="detail-row">
          <span class="label">Class:</span>
          <span class="value">{{#each features.classes}}{{name}} {{level}}{{#unless @last}}, {{/unless}}{{/each}}</span>
        </div>
        <div class="detail-row">
          <span class="label">Background:</span>
          <span class="value">{{features.background}}</span>
        </div>
        <div class="detail-row">
          <span class="label">Alignment:</span>
          <span class="value">{{system.details.alignment}}</span>
        </div>
      </div>
    </div>

    <div class="character-image">
      <div class="image-placeholder">
        <i class="fa-solid fa-user"></i>
        <span>Portrait</span>
      </div>
    </div>
  </div>

  {{! Main Content Grid }}
  <div class="sheet-grid">
    {{! Left Column - Abilities & Combat }}
    <div class="left-column">
      {{! Ability Scores }}
      <div class="section-card abilities-section">
        <h3 class="section-title">
          <i class="fa-solid fa-dumbbell"></i> Ability Scores
        </h3>
        <div class="abilities-grid">
          {{#each abilities}}
            <div class="ability-block" data-ability="{{@key}}">
              <div class="ability-name">{{name}}</div>
              <div class="ability-score" data-action="editAbility" data-ability="{{@key}}">
                {{score}}
              </div>
              <div class="ability-modifier">{{modifier}}</div>
              <button class="ability-roll-btn" data-action="rollAbility" data-ability="{{@key}}">
                <i class="fa-solid fa-dice-d20"></i>
              </button>
              {{#if savingThrow}}
                <div class="saving-throw" data-action="rollSavingThrow" data-ability="{{@key}}">
                  Save: {{savingThrow}}
                </div>
              {{/if}}
            </div>
          {{/each}}
        </div>
      </div>

      {{! Combat Stats }}
      <div class="section-card combat-section">
        <h3 class="section-title">
          <i class="fa-solid fa-shield"></i> Combat
        </h3>
        <div class="combat-stats">
          <div class="stat-row">
            <span class="stat-label">Hit Points:</span>
            <div class="hp-controls">
              <input type="number" value="{{combat.hitPoints.current}}" data-action="editHitPoints" data-type="current" class="hp-input">
              <span>/</span>
              <input type="number" value="{{combat.hitPoints.max}}" data-action="editHitPoints" data-type="max" class="hp-input">
              <span>+</span>
              <input type="number" value="{{combat.hitPoints.temp}}" data-action="editHitPoints" data-type="temp" class="hp-input temp">
            </div>
          </div>
          <div class="stat-row">
            <span class="stat-label">Armor Class:</span>
            <span class="stat-value">{{combat.armorClass}}</span>
          </div>
          <div class="stat-row">
            <span class="stat-label">Initiative:</span>
            <span class="stat-value">{{combat.initiative}}</span>
          </div>
          <div class="stat-row">
            <span class="stat-label">Speed:</span>
            <span class="stat-value">{{combat.speed}} ft.</span>
          </div>
          <div class="stat-row">
            <span class="stat-label">Hit Dice:</span>
            <span class="stat-value">{{combat.hitDice}}</span>
            <button class="roll-btn" data-action="rollHitDie">
              <i class="fa-solid fa-dice-d6"></i>
            </button>
          </div>
        </div>
      </div>
    </div>

    {{! Right Column - Skills & Equipment }}
    <div class="right-column">
      {{! Skills }}
      <div class="section-card skills-section">
        <h3 class="section-title">
          <i class="fa-solid fa-brain"></i> Skills
        </h3>
        <div class="skills-list">
          {{#each skills}}
            <div class="skill-row">
              <div class="skill-info">
                <span class="skill-name">{{name}}</span>
                <span class="skill-ability">({{ability}})</span>
              </div>
              <div class="skill-controls">
                {{#if proficient}}
                  <span class="proficiency-indicator proficient" data-action="toggleProficiency" data-type="skill" data-key="{{key}}">
                    <i class="fa-solid fa-circle"></i>
                  </span>
                {{else}}
                  <span class="proficiency-indicator" data-action="toggleProficiency" data-type="skill" data-key="{{key}}">
                    <i class="fa-regular fa-circle"></i>
                  </span>
                {{/if}}
                <span class="skill-modifier">{{modifier}}</span>
                <button class="skill-roll-btn" data-action="rollSkill" data-skill="{{key}}">
                  <i class="fa-solid fa-dice-d20"></i>
                </button>
              </div>
            </div>
          {{/each}}
        </div>
      </div>

      {{! Equipment }}
      <div class="section-card equipment-section">
        <h3 class="section-title">
          <i class="fa-solid fa-toolbox"></i> Equipment
        </h3>
        <div class="equipment-list">
          {{#each equipment}}
            <div class="equipment-item">
              <span class="item-name">{{name}}</span>
              {{#if (gt quantity 1)}}
                <span class="item-quantity">×{{quantity}}</span>
              {{/if}}
              {{#if equipped}}
                <span class="equipped-indicator">E</span>
              {{/if}}
            </div>
          {{else}}
            <div class="empty-equipment">
              <i class="fa-solid fa-box-open"></i>
              <span>No equipment</span>
            </div>
          {{/each}}
        </div>
      </div>
    </div>
  </div>

  {{! Bottom Section - Features & Biography }}
  <div class="bottom-section">
    {{! Features & Traits }}
    <div class="section-card features-section">
      <h3 class="section-title">
        <i class="fa-solid fa-star"></i> Features & Traits
      </h3>
      <div class="features-content">
        <div class="feature-item">
          <strong>Race:</strong> {{features.race}}
        </div>
        <div class="feature-item">
          <strong>Background:</strong> {{features.background}}
        </div>
        <div class="feature-item">
          <strong>Classes:</strong> {{#each features.classes}}{{name}} {{level}}{{#unless @last}}, {{/unless}}{{/each}}
        </div>
      </div>
    </div>

    {{! Biography }}
    <div class="section-card biography-section">
      <h3 class="section-title">
        <i class="fa-solid fa-book"></i> Biography
      </h3>
      <div class="biography-content">
        <div class="bio-field">
          <label>Personality:</label>
          <textarea>{{biography.personality}}</textarea>
        </div>
        <div class="bio-field">
          <label>Backstory:</label>
          <textarea>{{biography.backstory}}</textarea>
        </div>
      </div>
    </div>
  </div>
</div>